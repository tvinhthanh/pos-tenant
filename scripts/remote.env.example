# Thông tin kết nối database Supabase remote cho scripts/push-remote.ps1
# Copy thành .env.remote ở thư mục gốc repo (git bỏ qua .env.*), rồi điền mật khẩu.
# Lấy ở Dashboard → Connect → Shared pooler. Mật khẩu để trống = script hỏi lúc chạy.
SUPABASE_REMOTE_REF=ofolpfqgefpkoohlvhkr
SUPABASE_REMOTE_POOLER_HOST=aws-1-ap-northeast-2.pooler.supabase.com
# 5432 = chế độ session của pooler (chạy migration); 6543 (transaction) hay lỗi với migration
SUPABASE_REMOTE_PORT=5432
SUPABASE_REMOTE_DB_PASSWORD=

# ---- Deploy Edge Function (scripts/deploy-functions.ps1) ----
# Token của tài khoản sở hữu project: supabase.com → Account → Access Tokens. Chỉ repo này dùng.
SUPABASE_ACCESS_TOKEN=
# Mỗi dòng FN_SECRET_<TÊN> thành secret <TÊN> của Edge Function; để trống = bỏ qua
FN_SECRET_PLATFORM_DOMAIN=
FN_SECRET_SMS_PROVIDER=esms
FN_SECRET_SEND_SMS_HOOK_SECRET=
FN_SECRET_ESMS_API_KEY=
FN_SECRET_ESMS_SECRET_KEY=
FN_SECRET_ESMS_BRANDNAME=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Optional: login accepts "owner" and converts to owner@pos.local.
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=pos.local

# Optional UI privacy lock for admin screens. This is not an authorization layer;
# real authorization must stay in Supabase Auth, RLS, and RPC checks.

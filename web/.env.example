NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
# Publishable key (sb_publishable_…) ở Dashboard → Settings → API Keys (local: `supabase status`).
# Không bao giờ đặt secret key (sb_secret_…) ở đây.
# Biến cũ NEXT_PUBLIC_SUPABASE_ANON_KEY vẫn được đọc làm fallback, nhưng hãy đổi sang biến này.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-sb_publishable-key

# Optional: login accepts "owner" and converts to owner@pos.local.
NEXT_PUBLIC_INTERNAL_EMAIL_DOMAIN=pos.local

# Optional UI privacy lock for admin screens. This is not an authorization layer;
# real authorization must stay in Supabase Auth, RLS, and RPC checks.

# Multi-shop
# Tên miền nền tảng: website shop ở <subdomain>.<PLATFORM_DOMAIN>
#   Máy dev: đặt localhost → mở http://<subdomain>.localhost:3000 (Chrome tự trỏ *.localhost về máy).
#   Bỏ trống: chỉ xem website qua http://localhost:3000/site/<subdomain>
NEXT_PUBLIC_PLATFORM_DOMAIN=
# Server Next gọi Supabase qua địa chỉ nội bộ (Docker). Bỏ trống = dùng NEXT_PUBLIC_SUPABASE_URL
SUPABASE_INTERNAL_URL=
# Cloudflare Turnstile cho trang /signup (bỏ trống ở local; Edge Function self-signup cần TURNSTILE_SECRET_KEY tương ứng)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
